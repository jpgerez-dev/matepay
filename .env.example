# ─── MatePay (SOLO devnet) ───────────────────────────────────────────────
# RPC de devnet. Si lo dejás vacío usa el público (api.devnet.solana.com).
# Un RPC propio (Helius/Triton devnet) evita los límites del público.
# El server se niega a arrancar si el RPC no es devnet.
SOLANA_RPC_URL=

# Wallet que paga las comisiones (fee payer). Si la dejás vacía, el server
# genera una en .keys/fee-payer.json (ignorada por git). Base58 o array JSON.
# Necesita SOL de devnet: https://faucet.solana.com
FEE_PAYER_SECRET_KEY=

# Wallet del comercio de la demo (@cafedelaesquina). Igual que arriba.
DEMO_MERCHANT_SECRET_KEY=

# URL pública HTTPS de la app (ngrok, cloudflared, Cloud Run...). Si está
# definida, los QR del POS usan "transaction request" y Phantom mobile
# puede pagar sin SOL escaneando directo. Sin HTTPS, el QR es un transfer
# request común (MatePay paga gasless; otras wallets pagan su comisión).
APP_URL=

# Tope por pago, en USDC.
MAX_PAYMENT_USDC=1000

# Front: RPC para el wallet adapter (opcional) y herramientas internas del equipo.
VITE_SOLANA_RPC_URL=
VITE_SHOW_STUDIO=false

# ─── Studio interno (opcional) ───────────────────────────────────────────
GEMINI_API_KEY=
